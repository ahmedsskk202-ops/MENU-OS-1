# Copy this to packages/db/.env and apps/web/.env.local (both need DATABASE_URL).

# Local SQLite database. A `file:` path is resolved by Prisma against the directory
# holding the schema file (packages/db/prisma/), NOT the process cwd — so the short
# form below is correct for every `prisma` CLI command, and the web app (which loads
# its env from apps/web/ and never touches the schema) needs the same path written
# as an absolute file: URL.
DATABASE_URL="file:./menu-os.db"

# NextAuth (staff/admin login sessions).
NEXTAUTH_URL="http://localhost:3100"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# Signs the customer table-session cookie set on QR scan.
CUSTOMER_SESSION_SECRET="replace-with-a-different-random-32-byte-secret"

# Head-office sync service (apps/cloud). Only needed if you run `npm run dev:cloud`.
# A local SQLite file, entirely separate from the branch database above — branches
# never depend on it to operate, it only aggregates what they push.
# CLOUD_DATABASE_URL="file:./cloud.db"
# CLOUD_PORT=3200

# ── Online payments (optional) ─────────────────────────────────────────────
# Nothing below is enabled unless its credentials are set; without them the checkout
# stays "pay at the counter / to the waiter" exactly as before. See apps/web/lib/payments.
# Public https origin the card gateway sends the payer back to.
PAYMENTS_PUBLIC_BASE_URL=""
# Visa / Mastercard via Mastercard Gateway (MPGS) Hosted Checkout — values from your acquirer.
CARD_GATEWAY_BASE_URL=""          # e.g. https://test-gateway.mastercard.com
CARD_GATEWAY_MERCHANT_ID=""
CARD_GATEWAY_API_PASSWORD=""
CARD_GATEWAY_API_VERSION="100"
CARD_GATEWAY_MERCHANT_NAME=""
# Optional: webhook notifications. Enable them in Merchant Administration → Admin → Webhook
# Notifications and copy its "Notification Secret" here; the gateway then POSTs to
#   <PAYMENTS_PUBLIC_BASE_URL>/api/payments/online/webhook/card   (https only)
CARD_GATEWAY_NOTIFICATION_SECRET=""
# Local simulator for development only ("CARD"). Ignored when NODE_ENV=production.
PAYMENTS_MOCK_PROVIDERS=""

# ── Menu OS license (required) ─────────────────────────────────────────────
# Address of the Menu OS License site on Netlify. Every page and API is locked until a
# license issued there is activated at http://<this server>/license.
MENU_OS_LICENSE_SERVER=""          # e.g. https://menu-os-licenses.netlify.app
# Optional: pin the license site's public key (from <site>/api/public-key) instead of
# trusting the key fetched on first activation.
MENU_OS_LICENSE_PUBLIC_KEY=""
# How long the system keeps working without reaching the license site (days), and how
# often it re-checks (hours).
MENU_OS_LICENSE_GRACE_DAYS="7"
MENU_OS_LICENSE_CHECK_HOURS="6"

