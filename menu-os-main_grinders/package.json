{
  "name": "menu-os",
  "private": true,
  "version": "0.1.0",
  "description": "Restaurant Experience Platform — QR ordering, kitchen, tables, payments, analytics, and multiplayer games for restaurants and cafes.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:cloud": "npm run dev --workspace=apps/cloud",
    "build": "npm run build --workspace=packages/db && npm run build --workspace=apps/web",
    "db:generate": "npm run generate --workspace=packages/db",
    "db:push": "npm run push --workspace=packages/db",
    "db:migrate": "npm run migrate --workspace=packages/db",
    "db:seed": "npm run seed --workspace=packages/db",
    "db:seed:grinders": "npm run seed:grinders --workspace=packages/db",
    "db:sync-roles": "npm run sync-roles --workspace=packages/db",
    "db:update": "node scripts/db-update.mjs",
    "db:studio": "npm run studio --workspace=packages/db",
    "cloud:generate": "npm run generate --workspace=packages/cloud-db",
    "cloud:push": "npm run push --workspace=packages/cloud-db",
    "cloud:seed": "npm run seed --workspace=packages/cloud-db",
    "cloud:studio": "npm run studio --workspace=packages/cloud-db",
    "test": "npm run test --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "unrs-resolver@1.12.2": true
  }
}
